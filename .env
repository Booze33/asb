# Docker Compose Environment Variables
# This file provides the environment variables needed by docker-compose.yml
# It sources values from server/.env for consistency

# Load variables from server/.env
POSTGRES_DB=salon_appointment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=your_strong_redis_password_here

# Optional: You can override these if needed for Docker specifically
# NODE_ENV=development
# PORT=3008