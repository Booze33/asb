# Production Environment Variables

# Application
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Redis
REDIS_URL=redis://username:password@hostname:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yoursalon.com

# WhatsApp Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend URL
FRONTEND_URL=https://your-salon-domain.com

# Security
CORS_ORIGIN=https://your-salon-domain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info

# Health Check
HEALTH_CHECK_PATH=/api/health
HEALTH_CHECK_TIMEOUT=5000

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key

# External Services
BACKUP_SERVICE_URL=https://your-backup-service.com
MONITORING_SERVICE_URL=https://your-monitoring-service.com