# Server Configuration
PORT=3000

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/salon_appointment_db"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key-change-this-in-production"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
ADMIN_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
CACHE_ALLOWED_ORIGINS="http://localhost:3000"

# Email Configuration
EMAIL_API_KEY="your-email-api-key"
EMAIL_FROM="noreply@salonapp.com"

# WhatsApp Configuration
WHATSAPP_API_KEY="your-whatsapp-api-key"
WHATSAPP_PHONE_NUMBER="your-whatsapp-phone-number"

# Other Configuration
NODE_ENV=development
LOG_LEVEL=info